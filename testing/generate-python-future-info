#!/usr/bin/env python3
from __future__ import annotations

import builtins
import os.path
import subprocess
import sys

import future.builtins


def main() -> int:
    names = sorted(
        k for k, v in vars(future.builtins).items()
        if getattr(builtins, k, None) is v
    )
    lines = [f'# Using future=={future.__version__}']
    lines.append('REMOVALS[(3,)].update((')
    lines.append("    'from builtins import *',")
    for name in names:
        lines.append(f"    'from builtins import {name}',")
    lines.append('))')

    proc = subprocess.run(
        (
            sys.executable,
            os.path.join(os.path.dirname(sys.argv[0]), '_replace'),
            os.path.basename(sys.argv[0]),
        ),
        input='\n'.join(lines).encode(),
    )
    return proc.returncode


if __name__ == '__main__':
    raise SystemExit(main())
