#!/usr/bin/env python3
from __future__ import annotations

import collections.abc
import os.path
import subprocess
import sys


def main() -> int:
    lines = ['REPLACES[(3,)].update((']
    for k in sorted(collections.abc.__all__):
        lines.append(f"    'collections=collections.abc:{k}',")
    lines.append("    'pipes=shlex:quote',")
    lines.append("    'xml.etree.cElementTree=xml.etree.ElementTree',")
    lines.append('))')

    proc = subprocess.run(
        (
            sys.executable,
            os.path.join(os.path.dirname(sys.argv[0]), '_replace'),
            os.path.basename(sys.argv[0]),
        ),
        input='\n'.join(lines).encode(),
    )
    return proc.returncode


if __name__ == '__main__':
    raise SystemExit(main())
