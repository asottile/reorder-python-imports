#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from collections.abc import Sequence


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument('name')
    args = parser.parse_args()

    header = f'# GENERATED VIA {args.name}\n'
    footer = '# END GENERATED\n'

    generated = f'{sys.stdin.read().rstrip()}\n'
    with open('reorder_python_imports.py') as f:
        contents = f.read()

    assert header in contents
    before, _, rest = contents.partition(header)
    _, _, rest = rest.partition(footer)

    with open('reorder_python_imports.py', 'w') as f:
        f.write(before + header + generated + footer + rest)

    return 0


if __name__ == '__main__':
    raise SystemExit(main())
