#!/usr/bin/env python3
from __future__ import annotations

import ast
import os.path
import subprocess
import sys
import tokenize


def raw(s: str) -> str:
    for q in ("'", '"'):
        as_raw = f'r{q}{s}{q}'
        try:
            if ast.literal_eval(as_raw) == s:
                return as_raw
        except SyntaxError:
            continue
    else:
        return repr(s)


def _escaped_newline(s: str) -> str:
    return s.replace(r'\\.|', r'\\.|\\\n|')


def main() -> int:
    # only want the prefixes that can be docstrings
    string_prefix = '[RrUu]?'

    double_3 = f'"""{_escaped_newline(tokenize.Double3)}'
    single_3 = f"'''{_escaped_newline(tokenize.Single3)}"
    double_1 = f'"{tokenize.Double}'
    single_1 = f"'{tokenize.Single}"

    lines = []
    lines.append(f'COMMENT = {raw(tokenize.Comment)}')
    lines.append(f'NAME = {raw(tokenize.Name)}')
    lines.append(f'PREFIX = {raw(string_prefix)}')
    lines.append(f'DOUBLE_3 = {raw(double_3)}')
    lines.append(f'SINGLE_3 = {raw(single_3)}')
    lines.append(f'DOUBLE_1 = {raw(double_1)}')
    lines.append(f'SINGLE_1 = {raw(single_1)}')

    proc = subprocess.run(
        (
            sys.executable,
            os.path.join(os.path.dirname(sys.argv[0]), '_replace'),
            os.path.basename(sys.argv[0]),
        ),
        input='\n'.join(lines).encode(),
    )
    return proc.returncode


if __name__ == '__main__':
    raise SystemExit(main())
